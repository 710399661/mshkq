{
  "name": "@discuzq/utils",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format.ts",
    "./date": "./src/date.ts",
    "./string": "./src/string.ts",
    "./validation": "./src/validation.ts",
    "./dom": "./src/dom.ts"
  },
  "typesVersions": {
    "*": {
      "*": ["src/*"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@discuzq/eslint-config": "workspace:*",
    "@discuzq/tsconfig": "workspace:*",
    "typescript": "^5.5.0"
  }
}
