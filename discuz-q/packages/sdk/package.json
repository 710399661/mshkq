{
  "name": "@discuzq/sdk",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types/index.ts"
  },
  "typesVersions": {
    "*": {
      "*": ["src/*"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@discuzq/utils": "workspace:*"
  },
  "devDependencies": {
    "@discuzq/eslint-config": "workspace:*",
    "@discuzq/tsconfig": "workspace:*",
    "typescript": "^5.5.0"
  }
}
