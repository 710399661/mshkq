{
  "name": "@discuzq/ui",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./button": "./src/components/button/index.tsx",
    "./card": "./src/components/card/index.tsx",
    "./input": "./src/components/input/index.tsx",
    "./avatar": "./src/components/avatar/index.tsx",
    "./badge": "./src/components/badge/index.tsx",
    "./tag": "./src/components/tag/index.tsx",
    "./divider": "./src/components/divider/index.tsx",
    "./skeleton": "./src/components/skeleton/index.tsx",
    "./empty": "./src/components/empty/index.tsx",
    "./tabs": "./src/components/tabs/index.tsx",
    "./tooltip": "./src/components/tooltip/index.tsx",
    "./dialog": "./src/components/dialog/index.tsx",
    "./toast": "./src/components/toast/index.tsx",
    "./loading": "./src/components/loading/index.tsx",
    "./pagination": "./src/components/pagination/index.tsx",
    "./dropdown-menu": "./src/components/dropdown-menu/index.tsx",
    "./avatar-uploader": "./src/components/avatar-uploader/index.tsx",
    "./rich-text": "./src/components/rich-text/index.tsx",
    "./comment": "./src/components/comment/index.tsx",
    "./post-card": "./src/components/post-card/index.tsx",
    "./user-card": "./src/components/user-card/index.tsx"
  },
  "typesVersions": {
    "*": {
      "*": ["src/*"]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@discuzq/utils": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@discuzq/eslint-config": "workspace:*",
    "@discuzq/tailwind-config": "workspace:*",
    "@discuzq/tsconfig": "workspace:*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
