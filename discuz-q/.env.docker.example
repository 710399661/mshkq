# ============================================
# Docker Compose 环境变量配置
# ============================================

# Nginx
NGINX_PORT=80

# MySQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=discuz_q
DB_USERNAME=discuz_q
DB_PASSWORD=secret

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Laravel API
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost
APP_TIMEZONE=Asia/Shanghai
RUN_SEEDER=false

# Next.js Web (前台)
NEXT_PUBLIC_APP_NAME="Discuz! Q"
NEXT_PUBLIC_APP_URL="http://localhost"
NEXT_PUBLIC_API_BASE_URL="http://localhost/api/v1"
NEXT_PUBLIC_SITE_DESCRIPTION="新一代社区论坛系统"
NEXT_PUBLIC_SITE_KEYWORDS="Discuz,社区,论坛,问答"

# Next.js Admin (管理后台)
NEXT_PUBLIC_ADMIN_APP_NAME="Discuz! Q 管理后台"
NEXT_PUBLIC_ADMIN_URL="http://localhost/admin"
