{
  "name": "@discuzq/sdk",
  "version": "1.0.55",
  "description": "discuz dsk - API SDK for Discuz Q",
  "main": "dist/index.js",
  "license": "MIT",
  "files": [
    "dist/",
    "dist-pure/",
    "README.md",
    "package.json",
    "script"
  ],
  "scripts": {
    "dzq-sdk": "node ./script/sdk.cli.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:web": "DISCUZ_ENV=web npx rollup -c rollup.config.js",
    "build:mini": "DISCUZ_ENV=mini npx rollup -c rollup.config.js",
    "build:uniapp": "DISCUZ_ENV=uniapp npx rollup -c rollup.config.js",
    "build": "gulp clean && gulp build && gulp build-pure",
    "docs": "gulp docs",
    "watch": "gulp watch",
    "lint": "eslint -c .eslintrc.js ./ --ext .js,.jsx",
    "lint:fix": "eslint -c .eslintrc.js ./ --ext .js,.jsx --fix",
    "dev:taro": "cd ./examples/taro-demo && npm run dev:weapp",
    "dev:uniapp": "cd ./examples/uniapp-demo && npm run dev:mp-weixin",
    "dev:next": "npm link && cd ./examples/nextjs-demo && npm link @discuz/sdk && npm run dev"
  },
  "bin": {
    "dzq-sdk": "./script/sdk.cli.js"
  },
  "keywords": [
    "xhr",
    "http",
    "ajax",
    "promise",
    "node",
    "taro",
    "uniapp",
    "utils"
  ],
  "author": "angelzou",
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-arrow-functions": "^7.23.0",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-eslint": "^8.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "docdash": "^2.0.2",
    "eslint": "^8.57.0",
    "eslint-config-tencent": "^2.1.1",
    "eslint-plugin-import": "^2.29.1",
    "fs-extra": "^11.2.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-conflict": "^0.4.0",
    "gulp-jsdoc3": "^3.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-template": "^5.0.0",
    "inquirer": "^9.2.12",
    "jsdoc": "^4.0.2",
    "react-dom": "^18.2.0",
    "rollup": "^4.9.0",
    "shelljs": "^0.8.5"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.0",
    "async-validator": "^4.2.5",
    "axios": "^1.6.5",
    "core-js": "^3.35.0",
    "dayjs": "^1.11.10",
    "qs": "^6.11.2"
  },
  "gitHead": "96b795dcf4d14a389db6cf1aab41cbd3e9bbe4ba"
}
