  "scripts": {
    "lint": "eslint -c .eslintrc.js ./ --ext .js,.jsx",
    "lint:fix": "eslint -c .eslintrc.js ./ --ext .js,.jsx --fix",
    "init:web": "rm -rf example/web && cd example && DEBUG='*' dzq init web",
    "init:mini": "rm -rf example/mini && cd example && DEBUG='*' dzq init mini -p mini",
    "create:next_tpl": "create-next-app",
    "create:taro_tpl": "npx @tarojs/cli init ./template/taro-default"
  },
