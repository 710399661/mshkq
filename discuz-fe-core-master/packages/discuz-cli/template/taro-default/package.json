{
  "name": "discuz-app-mini",
  "version": "1.0.1",
  "private": true,
  "description": "Discuz! Q Mini",
  "templateInfo": {
    "name": "mobx",
    "typescript": false,
    "css": "sass"
  },
  "scripts": {
    "lint:fix": "eslint --ext .js,.ts,.tsx,.jsx ./ --max-warnings 0 --fix",
    "lintcss:fix": "stylelint src/**/*.{scss}",
    "dev:weapp": "NODE_ENV=production dzq dev -p mini --type weapp",
    "build:weapp": "NODE_ENV=production dzq build -p mini --type weapp"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.23.0",
    "@tarojs/components": "^3.6.25",
    "@tarojs/react": "^3.6.25",
    "@tarojs/runtime": "^3.6.25",
    "@tarojs/taro": "^3.6.25",
    "mobx": "^6.12.0",
    "mobx-react": "^9.1.0",
    "react-dom": "^18.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@discuzq/cli": "^1.3.20",
    "@tarojs/cli": "^3.6.25",
    "@tarojs/mini-runner": "^3.6.25",
    "@tarojs/webpack-runner": "^3.6.25",
    "@types/react": "^18.2.48",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "^3.6.25",
    "commitizen": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-taro": "^3.6.25",
    "eslint-config-tencent": "^2.1.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^4.12.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "stylelint": "^16.1.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-prettier": "^5.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
